{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":dependencyDashboard",
  ],

  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/^versions\\.ya?ml$/"],
      matchStrings: [
        // Image refs: `key: image:tag[@sha256:…]` or `- image:tag[@sha256:…]`
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+(?:\\w+:\\s*|-\\s+)[^\\s:@]+:(?<currentValue>[^\\s@]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?",
        // Plain versions: `key: v1.2.3` (no '/', ':' or '@', so image lines can't match)
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+\\w+:\\s*(?<currentValue>[^\\s:/@]+)(?:\\s|$)",
      ],
      datasourceTemplate: "{{{datasource}}}",
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
    },
  ],

  packageRules: [
    {
      matchPackageNames: ["siderolabs/talos"],
      automerge: false,
      prBodyNotes: [
        "**Before merging:** rebase the RP1 PWM branch in the pkgs fork onto the pkgs commit this Talos release pins (`grep '^PKGS ?=' Makefile`), tag it `v<talos-version>-1`, and wait for the kernel workflow to publish the image.",
        "**On a minor bump:** raise the `sbc-raspberrypi` `allowedVersions` cap to the matching overlay line.",
      ],
    },
    {
      matchPackageNames: ["ghcr.io/hoefling/kernel"],
      ignoreUnstable: false,
      automerge: false,
      pinDigests: true,
      allowedVersions: "!/-(amd64|arm64)$/",
    },
    {
      matchPackageNames: ["siderolabs/talos", "ghcr.io/hoefling/kernel"],
      groupName: "talos + kernel",
    },
    {
      // Overlay lines track Talos minors: v0.2.x ↔ 1.14, v0.3.x ↔ 1.15.
      // The one manual coupling: raise this together with the Talos minor bump.
      matchPackageNames: ["ghcr.io/siderolabs/sbc-raspberrypi"],
      allowedVersions: "<0.3.0",
      pinDigests: true,
    },
    {
      // Userspace extensions only; vc4 follows talos_version and is not managed here.
      matchPackageNames: ["ghcr.io/siderolabs/iscsi-tools", "ghcr.io/siderolabs/util-linux-tools"],
      groupName: "sidero extensions",
      automerge: false,
    },
    {
      matchManagers: ["github-actions"],
      pinDigests: true,
      groupName: "github actions",
      automerge: true,
    },
  ],

  prConcurrentLimit: 3,
  prHourlyLimit: 2,
  schedule: ["* 0-6 * * 1"],
  timezone: "Europe/Berlin",
}
